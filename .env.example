# ─────────────────────────────────────────────────────────────────────────────
# VendorLink environment variables
# Copy to `.env.local` and fill in. NEVER commit real values.
#
# SECURITY RULE (hard rule of this codebase):
#   • Client-side: ONLY the Supabase anon key (public by design).
#   • Server-side only: SUPABASE_SERVICE_ROLE_KEY is used by the image-upload
#     Route Handler — it must never be a NEXT_PUBLIC_* variable.
#   • The Paystack SECRET key lives exclusively inside the Supabase Edge
#     Function (paystack-webhook) — never in this file, never in the browser.
# ─────────────────────────────────────────────────────────────────────────────

# Supabase (Project Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOi...

# Service-role key — SERVER ONLY (image uploads to Supabase Storage).
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# Canonical URL of the deployed app (used for magic-link redirects)
NEXT_PUBLIC_APP_URL=https://your-app.vercel.app

# ─────────────────────────────────────────────────────────────────────────────
# Supabase Edge Function secrets (NOT stored in this repo — set with):
#   supabase secrets set PAYSTACK_SECRET_KEY=sk_live_xxx
#   supabase secrets set SUPABASE_URL=https://xxxx.supabase.co
#   supabase secrets set SUPABASE_SERVICE_ROLE_KEY=eyJ...
# ─────────────────────────────────────────────────────────────────────────────
